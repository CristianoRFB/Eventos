{
  "name": "eventos77",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/assert-deployment-disabled.mjs",
    "prebuild": "node scripts/assert-deployment-disabled.mjs",
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "setup:local": "node scripts/setup-local.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "lint": "eslint .",
    "format": "prettier --write app workers scripts tests *.ts *.js",
    "test": "vitest run",
    "test:integration": "node scripts/reset-integration-local.mjs && playwright test --project=api",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:diagrams": "node scripts/render-diagrams.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@eslint/js": "10.0.1",
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "version": "0.2.0-dev",
  "optionalDependencies": {
    "@emnapi/wasi-threads": "1.2.3"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "overrides": {
    "@mermaid-js/mermaid-cli": {
      "katex": "0.18.10"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
