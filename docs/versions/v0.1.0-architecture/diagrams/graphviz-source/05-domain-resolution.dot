digraph G {
graph [rankdir=LR, bgcolor="#FFFFFF", fontname="DejaVu Sans", label="Resolucao segura por hostname — ESQUEMA PROPOSTO", labelloc=t, fontsize=20, pad=0.3, nodesep=0.4, ranksep=0.7];
