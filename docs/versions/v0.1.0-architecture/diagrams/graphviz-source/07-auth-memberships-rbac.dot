digraph G {
graph [rankdir=LR, bgcolor="#FFFFFF", fontname="DejaVu Sans", label="Fluxo de autorizacao — ESQUEMA PROPOSTO", labelloc=t, fontsize=20, pad=0.3, nodesep=0.4, ranksep=0.7];
node [shape=box, style="rounded,filled", fillcolor="#EAF3F6", color="#456C80", fontname="DejaVu Sans",fontsize=12,margin="0.15,0.09"];
edge [color="#668499", arrowsize=0.7];
x_session [label="Cookie Host-only"];
x_validate [label="Sessao + CSRF"];
