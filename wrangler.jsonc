{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventos77",
  "main": "workers/app.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {"APP_ENV":"local","ADMIN_ORIGIN":"http://localhost:5173","CUSTOM_DOMAINS_ENABLED":"false","OUTBOUND_MESSAGES_ENABLED":"false","COMMERCIAL_GATING_ENABLED":"false"},
  "d1_databases": [{"binding":"DB","database_name":"eventos77-local","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"ASSETS_PRIVATE","bucket_name":"eventos77-local-private"}],
  "observability": {"enabled": true}
}
